{
  "description": "stack-core: PreToolUse guard (deny/ask on destructive, irreversible, or secret-leaking actions) and PostToolUse project-formatter. Both are silent on success. Disable per process with CLAUDE_GUARD=off / CLAUDE_FORMAT=off.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "command -v python3 >/dev/null 2>&1 || exit 0; python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "command -v python3 >/dev/null 2>&1 || exit 0; python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/format.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
